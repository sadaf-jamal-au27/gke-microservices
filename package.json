{
  "name": "retail-platform",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "generate:services": "node application/scripts/generate-services.mjs",
    "generate:auto": "node application/scripts/generate-automobile-services.mjs",
    "setup": "bash application/scripts/setup-local.sh",
    "dev": "bash application/scripts/dev-local.sh",
    "dev:stop": "bash application/scripts/dev-stop.sh",
    "dev:auto": "bash application/scripts/dev-automobile.sh",
    "build": "pnpm -r build",
    "dev:bff": "pnpm --filter @retail/bff-api-service dev",
    "dev:storefront": "pnpm --filter @retail/storefront dev",
    "dev:admin": "pnpm --filter @retail/admin dev",
    "lint": "echo \"Add eslint in CI\"",
    "test:e2e": "bash testing/e2e/run-smoke.sh",
    "test:infra:unit": "bash infra/scripts/test-unit.sh dev",
    "test:devops": "bash devops/scripts/validate-helm.sh dev"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
